# Copia este archivo a ".env" (que NO se sube a git) y ajusta lo que necesites.

# --- Postgres (CoreApi) ---
DB_NAME=core_api
DB_USER=core_api
DB_PASSWORD=core_api

# --- RabbitMQ (Ingestor <-> ModerationEngine) ---
RABBITMQ_USER=twitchspam
RABBITMQ_PASSWORD=twitchspam
# Debe coincidir con MODERATION_QUEUE en Ingestor y app.rabbitmq.queue en ModerationEngine
MODERATION_QUEUE=chat-messages

# --- Twitch (Ingestor) ---
# Si se dejan vacias, el Ingestor se conecta en modo anonimo (solo lectura).
TWITCH_USERNAME=
TWITCH_OAUTH_TOKEN=
